rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Classroom cohorts created by teachers or joined by students
    match /classes/{classCode} {
      allow read, write: if true;
    }

    // Student exam score submissions
    match /examSubmissions/{submissionId} {
      allow read, write: if true;
    }
  }
}
